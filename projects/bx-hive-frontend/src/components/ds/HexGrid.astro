---
// Static version of ds/hex-grid.tsx.
interface Props {
  opacity?: number
  class?: string
}
const { opacity = 0.5, class: className } = Astro.props
const patternId = 'hex-grid-pattern'
---

<svg width="100%" height="100%" class={className} style={`position: absolute; inset: 0; opacity: ${opacity};`} aria-hidden="true">
  <defs>
    <pattern id={patternId} width="36" height="62.35" patternUnits="userSpaceOnUse">
      <path d="M18 1 L34 10 L34 30 L18 39 L2 30 L2 10 Z" fill="none" stroke="var(--rule)" stroke-width="0.6"></path>
      <path d="M0 32 L16 41 L16 61 L0 70 Z M36 32 L52 41 L52 61 L36 70 Z" fill="none" stroke="var(--rule)" stroke-width="0.6"></path>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${patternId})`}></rect>
</svg>
