---
// Static Astro port of ds/wordmark.tsx for marketing/blog pages.
import HexMark from './HexMark.astro'
interface Props {
  size?: number
  class?: string
}
const { size = 18, class: className } = Astro.props
---

<span class:list={['inline-flex items-center gap-2 text-primary', className]}>
  <HexMark size={size} />
  <span
    class="text-foreground"
    style={`font-family: var(--font-display); font-style: italic; font-weight: 500; font-size: ${size + 2}px; letter-spacing: -0.02em; line-height: 1;`}
  >
    bxHive
  </span>
</span>
