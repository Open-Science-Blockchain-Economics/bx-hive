---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteHeader from '@/components/layout/SiteHeader.astro'
import Footer from '@/components/layout/Footer.astro'
import Icon from '@/components/ds/Icon.astro'
import PillBtn from '@/components/ui/PillBtn.astro'
import RoleCard from '@/components/ui/RoleCard.astro'
import ProtocolStages from '@/components/landing/ProtocolStages.astro'
---

<BaseLayout
  title="bxHive — verifiable behavioral research"
  description="bxHive is a platform for verifiable behavioral research. Join incentivized studies, contribute to open science, get rewarded — every decision lives on a public blockchain."
>
  <SiteHeader />

  <!-- Hero -->
  <section class="px-6 md:px-12 lg:px-20 pt-16 pb-14 md:pt-30 md:pb-24 border-b border-border">
    <div class="max-w-[1240px] mx-auto">
      <h1 class="font-ui font-medium text-[44px] md:text-[64px] lg:text-[88px] leading-none tracking-[-0.025em] max-w-[1180px]">
        Join a study.<br />
        Get rewarded.<br />
        Advance <span class="font-display italic font-normal text-primary tracking-[-0.02em]">open science</span>.
      </h1>
      <p class="font-ui text-lg leading-[1.55] mt-7 max-w-[660px] text-ink-2">
        bxHive is a platform for verifiable behavioral research. Join incentivized studies, contribute to open science, get rewarded — every
        decision lives on a public blockchain, so each study stays reproducible by construction.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <PillBtn href="/app/join?role=participant">
          Join <Icon name="arrow-right" size={16} />
        </PillBtn>
      </div>
    </div>
  </section>

  <!-- What is bxHive? -->
  <section id="about" class="px-6 md:px-12 lg:px-20 py-16 md:py-24 bg-muted border-b border-border">
    <div class="text-center max-w-[780px] mx-auto mb-14">
      <h2 class="font-ui font-medium text-[36px] md:text-[56px] leading-none tracking-[-0.025em] mb-4">
        What is <span class="font-display italic font-normal text-primary">bxHive</span>?
      </h2>
      <p class="font-ui text-lg leading-[1.55] text-ink-2">
        A platform for verifiable human experiments that uses smart contracts to automate research and transparently manage payouts.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 max-w-[1240px] mx-auto">
      <RoleCard
        title="About bxHive"
        icon="about"
        body="What bxHive is and why it exists — open science, public blockchains, and the bigger picture."
        cta="Learn more"
        href="/about"
      />
      <RoleCard
        title="Experimenters"
        icon="exp"
        body="Design, fund, and manage verifiable experiments using canonical templates. Specify base parameters once; deploy variations atomically."
        cta="Learn more"
        href="/for-experimenters"
      />
      <RoleCard
        title="Participants"
        icon="part"
        body="Participate in active research and receive transparent, automated payouts. Settled on-chain after every round."
        cta="Learn more"
        href="/for-participants"
      />
    </div>
  </section>

  <!-- Protocol -->
  <section class="px-6 md:px-12 lg:px-20 py-16 md:py-30">
    <div class="grid grid-cols-1 lg:grid-cols-[340px_1fr] gap-10 md:gap-16 max-w-[1280px] mx-auto">
      <div>
        <h2 class="font-ui font-medium text-[36px] md:text-[56px] leading-none tracking-[-0.025em]">
          From hypothesis<br />
          <span class="font-display italic font-normal text-primary">to dataset.</span>
        </h2>
        <p class="font-ui text-[15px] text-muted-foreground mt-4">Four stages, fully reproducible from the on-chain manifest.</p>
      </div>
      <ProtocolStages />
    </div>
  </section>

  <!-- Quote -->
  <section class="px-6 md:px-12 lg:px-20 py-16 md:py-24 bg-muted border-y border-border">
    <div class="max-w-[980px] mx-auto text-center">
      <span class="font-display italic text-[56px] md:text-[80px] leading-[0.5] text-primary">“</span>
      <p class="font-display italic font-light text-[24px] md:text-[38px] leading-[1.3] tracking-[-0.012em] mt-4 max-w-[880px] mx-auto">
        An audit-trail-first replacement for the lab. We replicated Berg, Dickhaut &amp; McCabe in a week.
      </p>
      <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground mt-7">Dr. M. Karras — Behavioral Lab, ETH</div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="px-6 md:px-12 lg:px-20 py-16 md:py-30 text-center">
    <h3 class="font-ui font-medium text-[40px] md:text-[64px] leading-none tracking-[-0.025em]">
      The lab is open.<br />
      <span class="font-display italic font-normal text-primary">Take a seat.</span>
    </h3>
    <div class="mt-9 inline-flex flex-wrap justify-center gap-3">
      <PillBtn href="/app/join?role=participant">
        Join <Icon name="arrow-right" size={16} />
      </PillBtn>
    </div>
  </section>

  <Footer />
</BaseLayout>
