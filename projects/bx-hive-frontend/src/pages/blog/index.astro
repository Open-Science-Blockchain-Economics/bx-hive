---
import { getCollection, type CollectionEntry } from 'astro:content'

import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteHeader from '@/components/layout/SiteHeader.astro'
import Footer from '@/components/layout/Footer.astro'

type Post = CollectionEntry<'blog'>
const posts = ((await getCollection('blog')) as Post[])
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

const dateFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })
---

<BaseLayout title="Blog · bxHive" description="Notes on verifiable behavioral research and on-chain experiments from the bxHive team.">
  <SiteHeader />

  <section class="px-6 md:px-12 lg:px-20 pt-20 pb-12 md:pt-28 md:pb-16 border-b border-border">
    <div class="max-w-[1240px] mx-auto">
      <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-primary mb-5">Blog</div>
      <h1 class="font-ui font-medium text-[40px] md:text-[56px] leading-[1.05] tracking-[-0.025em]">
        Notes from <span class="font-display italic font-normal text-primary">the hive</span>.
      </h1>
    </div>
  </section>

  <section class="px-6 md:px-12 lg:px-20 py-12 md:py-16">
    <div class="max-w-[1240px] mx-auto">
      {
        posts.length === 0 ? (
          <p class="font-ui text-[15px] text-muted-foreground">No posts yet — check back soon.</p>
        ) : (
          <ul class="list-none p-0 m-0 grid grid-cols-1 md:grid-cols-2 gap-5">
            {posts.map((post) => (
              <li>
                <a
                  href={`/blog/${post.id}`}
                  class="block h-full bg-card border border-border rounded-2xl p-8 hover:border-foreground transition-colors"
                >
                  <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground mb-3">
                    {dateFmt.format(post.data.pubDate)}
                  </div>
                  <h2 class="font-ui text-2xl font-medium tracking-[-0.012em]">
                    <span class="font-display italic font-normal">{post.data.title}</span>
                  </h2>
                  <p class="font-ui text-[15px] leading-[1.5] text-ink-2 mt-3 m-0">{post.data.description}</p>
                  <div class="font-ui text-[15px] mt-4">Read →</div>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <Footer />
</BaseLayout>
