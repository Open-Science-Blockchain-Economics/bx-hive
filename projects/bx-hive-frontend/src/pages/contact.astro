---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteHeader from '@/components/layout/SiteHeader.astro'
import Footer from '@/components/layout/Footer.astro'
import ContactForm from '@/components/contact/ContactForm.tsx'
---

<BaseLayout
  title="Contact · bxHive"
  description="Bring your hypothesis. Let's talk through it. Whether you're designing a study, joining one, or exploring an institutional pilot — tell us what you're working on."
>
  <SiteHeader />

  <!-- Hero -->
  <section class="px-6 md:px-12 lg:px-20 pt-24 pb-16 md:pt-32 md:pb-24 text-center">
    <div class="max-w-[760px] mx-auto">
      <h1 class="font-ui font-medium text-[40px] md:text-[56px] leading-[1.05] tracking-[-0.025em]">
        Bring your hypothesis.<br />
        <span class="font-display italic font-normal text-primary">Let's talk</span> through it.
      </h1>
      <p class="font-ui text-[17px] leading-[1.55] mt-7 text-ink-2 max-w-[620px] mx-auto">
        Whether you're designing a study, joining one as a participant, or exploring an institutional pilot — tell us what you're working on
        and we'll route you to the right person.
      </p>
    </div>
  </section>

  <!-- Form -->
  <section class="px-6 md:px-12 lg:px-20 pb-24 md:pb-32">
    <div class="max-w-[640px] mx-auto">
      <ContactForm client:load />
    </div>
  </section>

  <Footer />
</BaseLayout>
